<Page
    x:Class="UniDashboard.App.StudyPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="10" Padding="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="SummaryText" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                <Button x:Name="SyncButton" Content="Sync" Style="{StaticResource AccentButtonStyle}" Click="SyncButton_Click" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <ComboBox x:Name="PlanBox" MinWidth="420" PlaceholderText="Study plan" SelectionChanged="PlanBox_SelectionChanged" />
            <ToggleSwitch x:Name="OnlyMine" OnContent="Only my sections" OffContent="Whole plan" Toggled="OnlyMine_Toggled" />
        </StackPanel>
        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" IsClosable="True" />
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="TreeScroll">
                <StackPanel x:Name="TreeHost" Spacing="2" Padding="0,0,12,16" />
            </ScrollViewer>
            <Border x:Name="DetailPanel" Grid.Column="1" CornerRadius="8" Padding="18,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer>
                    <StackPanel x:Name="DetailHost" Spacing="10" />
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="EmptyHint" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="460"
                       Text="No study plan yet. Click Sync: it is built from your u:space studies and the u:find curriculum, for the semesters of your enrolled courses." />
        </Grid>
        <TextBlock Grid.Row="4" FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                   Text="The study plan comes from u:find (Universität Wien); which study is yours comes from u:space. This app is not provided by the university; the data may be wrong or incomplete." />
    </Grid>
</Page>
