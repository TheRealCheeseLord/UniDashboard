<Window
    x:Class="UniDashboard.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="Left" OpenPaneLength="200" SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Assignments" Tag="assignments" Icon="List" />
            <NavigationViewItem Content="Calendar" Tag="calendar" Icon="Calendar" />
            <NavigationViewItem Content="Courses" Tag="courses" Icon="Library" />
            <NavigationViewItem Content="Exam planner" Tag="planner" Icon="Calendar" />
            <NavigationViewItem Content="Export" Tag="export" Icon="Share" />
            <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Informational" Margin="16,8,16,0">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateInstallButton" Content="Install and restart" Click="UpdateInstall_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Window>
