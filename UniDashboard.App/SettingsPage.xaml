<Page
    x:Class="UniDashboard.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16,20,18" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,20,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

        <SelectorBar x:Name="Tabs" Grid.Row="1" HorizontalAlignment="Left" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem Text="Accounts" Tag="accounts" IsSelected="True" />
            <SelectorBarItem Text="Sync" Tag="sync" />
            <SelectorBarItem Text="Notifications" Tag="notify" />
            <SelectorBarItem Text="Calendar" Tag="calendar" />
            <SelectorBarItem Text="Documents" Tag="documents" />
            <SelectorBarItem Text="About &amp; updates" Tag="about" />
        </SelectorBar>

        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" IsClosable="True" MaxWidth="860" HorizontalAlignment="Left" />

        <ScrollViewer Grid.Row="3">
            <Grid MaxWidth="860" HorizontalAlignment="Left" Padding="0,0,16,32">

                <!-- ===================== ACCOUNTS ===================== -->
                <StackPanel x:Name="TabAccounts" Spacing="12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Moodle" Style="{StaticResource CardTitle}" />
                            <TextBox x:Name="BaseUrlBox" Header="Moodle address" LostFocus="BaseUrlBox_LostFocus" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="LoginButton" Content="Log in / log in again (opens your browser)" Click="LoginButton_Click" />
                                <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                                <TextBlock x:Name="LoginStatus" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Used for assignments. The app keeps its session and only asks again when Moodle says it has expired." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="University login (silent background login)" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Lets the background agent log in to Moodle and u:space without opening a browser. The password is stored in the Windows Credential Manager, never in the app's database." />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UserBox" Header="u:account username" />
                                <PasswordBox x:Name="PassBox" Grid.Column="1" Header="Password" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save" Click="SaveCreds_Click" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Remove" Click="RemoveCreds_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Google Calendar" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Connecting to Google, choosing the calendar and automatic syncing live on the Export page." />
                            <Button Content="Open the Export page" Click="OpenExport_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== SYNC ===================== -->
                <StackPanel x:Name="TabSync" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Background agent" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="A small hidden task that syncs regularly and sends notifications, even when the app is closed." />
                            <ToggleSwitch x:Name="AgentSwitch" Header="Sync in the background" OnContent="On" OffContent="Off" Toggled="AgentSwitch_Toggled" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <NumberBox x:Name="IntervalBox" Header="Check every (minutes)" Minimum="5" Maximum="1440" SpinButtonPlacementMode="Inline"
                                           ValueChanged="IntervalBox_ValueChanged" Width="220" />
                                <NumberBox x:Name="ReminderBox" Header="Remind before a deadline (hours)" Minimum="1" Maximum="240" SpinButtonPlacementMode="Inline"
                                           ValueChanged="ReminderBox_ValueChanged" Width="260" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Moodle courses to include" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Unticked courses are not synced and their assignments are hidden." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Refresh list" Click="RefreshCourses_Click" />
                                <Button Content="Select all" Click="SelectAllCourses_Click" />
                                <Button Content="Select none" Click="SelectNoCourses_Click" />
                            </StackPanel>
                            <StackPanel x:Name="CoursePanel" Spacing="2" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== NOTIFICATIONS ===================== -->
                <StackPanel x:Name="TabNotify" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Hint}" Text="Choose which events produce a Windows notification. Everything is still recorded in the app, whatever you switch off here." />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Assignments" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="NotifyAssignments" Spacing="2" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Courses &amp; lectures" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="NotifyCourses" Spacing="2" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Exams" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="NotifyExams" Spacing="2" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="App &amp; accounts" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="NotifySystem" Spacing="2" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== CALENDAR ===================== -->
                <StackPanel x:Name="TabCalendar" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="What the calendar shows" Style="{StaticResource CardTitle}" />
                            <ToggleSwitch x:Name="MovedSwitch" Header="Moved and cancelled sessions" OnContent="Shown" OffContent="Hidden" Toggled="MovedSwitch_Toggled" />
                            <TextBlock Style="{StaticResource Hint}" Text="Shows faded ghosts at the old time of a moved session and struck-through entries for cancelled ones, for about a week." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Developer" Style="{StaticResource CardTitle}" />
                            <ToggleSwitch x:Name="DemoSwitch" Header="Demo events" OnContent="On" OffContent="Off" Toggled="DemoSwitch_Toggled" />
                            <TextBlock Style="{StaticResource Hint}" Text="Adds a few fake events to the calendar for reviewing the layout. They are never exported." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== DOCUMENTS ===================== -->
                <StackPanel x:Name="TabDocuments" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Your details" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Printed on the title page and in the header of generated Word documents." />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NameBox" Header="Name" LostFocus="NameBox_LostFocus" />
                                <TextBox x:Name="MatrikelBox" Grid.Column="1" Header="Matrikelnummer" LostFocus="MatrikelBox_LostFocus" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Saving documents" Style="{StaticResource CardTitle}" />
                            <TextBox x:Name="DocxFolderBox" Header="The save dialog opens in this folder" LostFocus="DocxFolderBox_LostFocus" />
                            <Button Content="Choose folder…" Click="BrowseDocxFolder_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Word template" Style="{StaticResource CardTitle}" />
                            <TextBox x:Name="TemplateBox" Header="Template file (.docx / .dotx)" LostFocus="TemplateBox_LostFocus" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Browse…" Click="BrowseTemplate_Click" />
                                <Button Content="Restore the default template" Click="ResetTemplate_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Placeholders you can use in your own template: {{Title}} {{Course}} {{Author}} {{Matrikel}} {{Date}} {{DueDate}} {{MoodleUrl}} {{Description}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== ABOUT & UPDATES ===================== -->
                <StackPanel x:Name="TabAbout" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="VersionText" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Unofficial student tool, not affiliated with the Universität Wien, Moodle or Google. Free software under the GNU GPL v3 or later." />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <HyperlinkButton Content="Releases and release notes" NavigateUri="https://github.com/TheRealCheeseLord/UniDashboard/releases" Padding="0,4" />
                                <HyperlinkButton Content="Source code" NavigateUri="https://github.com/TheRealCheeseLord/UniDashboard" Padding="8,4" />
                                <HyperlinkButton Content="License" NavigateUri="https://github.com/TheRealCheeseLord/UniDashboard/blob/main/LICENSE" Padding="8,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="New versions are published on GitHub. The app checks at most once a day when it starts and only tells you; it never installs anything without your click. Downloads are verified with a SHA-256 checksum, your data stays untouched, and the app restarts afterwards." />
                            <ToggleSwitch x:Name="AutoUpdateSwitch" Header="Check for updates automatically" OnContent="On" OffContent="Off" Toggled="AutoUpdateSwitch_Toggled" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckUpdateButton" Content="Check now" Click="CheckUpdate_Click" />
                                <Button x:Name="InstallUpdateButton" Content="Install and restart" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="InstallUpdate_Click" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateNotes" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
