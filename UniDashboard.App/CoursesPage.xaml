<Page
    x:Class="UniDashboard.App.CoursesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniDashboard.App">

    <Grid ColumnSpacing="16" RowSpacing="6" Padding="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SyncButton" Content="Sync courses" Style="{StaticResource AccentButtonStyle}" Click="SyncButton_Click" />
                <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" />
            <ScrollViewer Grid.Row="2"><StackPanel x:Name="CourseHost" Spacing="2" Padding="0,0,10,12" /></ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel x:Name="Detail" Spacing="10" Visibility="Collapsed" Padding="0,0,12,16">
                <Border x:Name="KindChip" HorizontalAlignment="Left" CornerRadius="10" Padding="10,2,10,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="KindIcon" Glyph="&#xE8F1;" FontSize="12" />
                        <TextBlock x:Name="KindText" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="MetaText" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel x:Name="FactsPanel" Spacing="8" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="MoodleButton" Content="Open in Moodle" Click="MoodleButton_Click" />
                    <Button x:Name="UfindButton" Content="Open in u:find" Click="UfindButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <FontIcon x:Name="SessionsIcon" Glyph="&#xE787;" FontSize="16" />
                    <TextBlock Text="Sessions" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <ToggleSwitch x:Name="PastSwitch" Header="Show past sessions" Toggled="PastSwitch_Toggled" />
                <StackPanel x:Name="SessionsPanel" Spacing="1" />
                <StackPanel x:Name="ExamsPanel" Spacing="1" />
                <StackPanel x:Name="InfoPanel" Spacing="6" />
                <Expander x:Name="HistoryExpander" Header="History" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Expanding="HistoryExpander_Expanding" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <ListView x:Name="HistoryList" MaxHeight="180" SelectionChanged="HistoryList_SelectionChanged" />
                        <StackPanel x:Name="DiffPanel" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="EmptyHint" Grid.Column="1" Text="No courses yet — click “Sync courses”." HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                   Text="Course data comes from u:space and u:find (Universität Wien). This app is not provided by the university; the university takes no responsibility for the correctness of the data shown here. Non-commercial personal use." />
    </Grid>
</Page>
