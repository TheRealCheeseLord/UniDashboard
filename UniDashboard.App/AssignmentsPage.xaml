<Page
    x:Class="UniDashboard.App.AssignmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniDashboard.App">
    <Page.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16,20,18" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Soft filled rows with a small gap: clearly separate, no outlines -->
        <Style x:Key="RowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <DataTemplate x:Key="RowTemplate" x:DataType="local:AssignmentRow">
            <Grid Padding="14,11,14,11" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                 VerticalAlignment="Center" Visibility="{x:Bind UnseenVisibility}" />
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Course}" TextTrimming="CharacterEllipsis" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DueText}" Foreground="{x:Bind DueBrush}" FontSize="12" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              Visibility="{x:Bind SubmittedVisibility}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: overview + list -->
        <Grid RowSpacing="8" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SyncButton" Style="{StaticResource AccentButtonStyle}" Click="SyncButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Sync now" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                <TextBlock x:Name="LastSyncText" VerticalAlignment="Center" Style="{StaticResource Hint}" />
            </StackPanel>

            <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" />

            <!-- One line of text: what needs attention (filled in code) -->
            <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="2,2,0,0" Style="{StaticResource Hint}" />

            <SelectorBar x:Name="FilterBar" Grid.Row="3" HorizontalAlignment="Left" SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem Text="All" IsSelected="True" />
                <SelectorBarItem Text="Open" />
                <SelectorBarItem Text="Submitted" />
            </SelectorBar>

            <ScrollViewer Grid.Row="4">
                <StackPanel x:Name="GroupsPanel" Spacing="0" Padding="0,0,12,16" />
            </ScrollViewer>
        </Grid>

        <!-- Right: detail — soft filled sections, same language as the list rows -->
        <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
        <ScrollViewer>
            <StackPanel x:Name="DetailPanel" Spacing="10" Visibility="Collapsed" Padding="0,0,12,24" HorizontalAlignment="Stretch">

                <!-- Header: date, title, actions -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Width="72" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DateDow" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="DateDay" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="DateMonth" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="DetailCourse" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenButton" Style="{StaticResource AccentButtonStyle}" Click="OpenButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="Open in Moodle" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DocxButton" Click="DocxButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="Generate .docx" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Facts as a labelled table -->
                <Border Style="{StaticResource SectionStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Due" FontSize="16" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="DetailDue" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Name="DueRelative" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Status" FontSize="16" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="StatusIcon" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontSize="16" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Attachments" FontSize="16" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock x:Name="AttachmentsText" FontSize="16" Grid.Row="2" Grid.Column="1"
                                   ToolTipService.ToolTip="Attachments can be downloaded in Moodle" />
                    </Grid>
                </Border>

                <Border x:Name="GradeSection" Style="{StaticResource SectionStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Grade &amp; feedback" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailGrade" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="DetailFeedback" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Description" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailDescription" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <Expander x:Name="HistoryExpander" Header="History" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Expanding="HistoryExpander_Expanding">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="HistoryList" MaxHeight="180" SelectionChanged="HistoryList_SelectionChanged" />
                        <StackPanel x:Name="DiffPanel" Grid.Row="1" />
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        </Border>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyHint" Grid.Column="1" Text="Select an assignment" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>