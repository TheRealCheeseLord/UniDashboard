<Page
    x:Class="UniDashboard.App.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16,20,18" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}"><Setter Property="FontSize" Value="16" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Calendar export" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource Hint}" MaxWidth="860" HorizontalAlignment="Left"
                       Text="Take your lectures and registered exams to your own calendar. Every entry has a stable id, so exporting again updates entries instead of duplicating them." />
        </StackPanel>

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" MaxWidth="860" HorizontalAlignment="Left" />

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="12" Padding="0,0,16,32">

                <!-- Step 1: what -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="30" Height="30" CornerRadius="7" Background="#3056A0F0"><FontIcon Glyph="&#xE8B5;" FontSize="16" Foreground="#56A0F0" /></Border><TextBlock Text="What to export" Style="{StaticResource CardTitle}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="28">
                            <CheckBox x:Name="SessionsBox" Content="Lectures and course sessions" IsChecked="True" Click="Options_Changed" MinWidth="0" />
                            <CheckBox x:Name="ExamsBox" Content="Exams I'm registered for" IsChecked="True" Click="Options_Changed" MinWidth="0" />
                            <CheckBox x:Name="FutureBox" Content="Only upcoming" IsChecked="True" Click="Options_Changed" MinWidth="0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="CountSessions" FontSize="12" />
                            </Border>
                            <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="CountExams" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2: where -->
                <SelectorBar x:Name="Tabs" HorizontalAlignment="Left" SelectionChanged="Tabs_SelectionChanged">
                    <SelectorBarItem Text="Save as .ics file" Tag="ics" IsSelected="True" />
                    <SelectorBarItem Text="Sync to Google Calendar" Tag="google" />
                </SelectorBar>

                <!-- .ics -->
                <StackPanel x:Name="TabIcs" Spacing="12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="30" Height="30" CornerRadius="7" Background="#306CCB5F"><FontIcon Glyph="&#xE78C;" FontSize="16" Foreground="#6CCB5F" /></Border><TextBlock Text="Save as a calendar file" Style="{StaticResource CardTitle}" /></StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Import the file into Google Calendar, Outlook, Apple Calendar or any other app. Importing it again later updates the existing entries instead of creating duplicates." />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ComboBox x:Name="AlarmBox" Header="Reminder" SelectedIndex="0" MinWidth="200" SelectionChanged="Alarm_SelectionChanged">
                                    <ComboBoxItem Content="None" Tag="0" />
                                    <ComboBoxItem Content="10 minutes before" Tag="10" />
                                    <ComboBoxItem Content="30 minutes before" Tag="30" />
                                    <ComboBoxItem Content="1 hour before" Tag="60" />
                                </ComboBox>
                                <Button Content="Export .ics file…" Click="ExportIcs_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="30" Height="30" CornerRadius="7" Background="#30E8A838"><FontIcon Glyph="&#xE946;" FontSize="16" Foreground="#E8A838" /></Border><TextBlock Text="Good to know" Style="{StaticResource CardTitle}" /></StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="u:find's own iCal link creates new random ids on every download, which is why importing it repeatedly duplicates everything. This file keeps the same id per entry, so it doesn't." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Google (built in code) -->
                <StackPanel x:Name="GooglePanel" Spacing="12" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
