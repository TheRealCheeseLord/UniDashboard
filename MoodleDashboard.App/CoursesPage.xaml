<Page
    x:Class="MoodleDashboard.App.CoursesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoodleDashboard.App">
    <Page.Resources>
        <DataTemplate x:Key="CourseRowTemplate" x:DataType="local:CourseRow">
            <Grid Padding="4,10,4,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"
                         Visibility="{x:Bind UnseenVisibility}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1,6,1">
                            <TextBlock Text="{x:Bind TypeText}" FontSize="11" />
                        </Border>
                        <TextBlock Text="{x:Bind Meta}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Visibility="{x:Bind BadgeVisibility}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="10" Padding="8,2,8,2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind BadgeText}" FontSize="11" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid ColumnSpacing="16" RowSpacing="6" Padding="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SyncButton" Content="Sync courses" Style="{StaticResource AccentButtonStyle}" Click="SyncButton_Click" />
                <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" />
            <ListView x:Name="CourseList" Grid.Row="2" ItemTemplate="{StaticResource CourseRowTemplate}" SelectionChanged="CourseList_SelectionChanged" />
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel x:Name="Detail" Spacing="8" Visibility="Collapsed" Padding="0,0,12,16">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="MetaText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <TextBlock x:Name="LecturersText" TextWrapping="Wrap" />
                <TextBlock x:Name="RegText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="MoodleButton" Content="Open in Moodle" Click="MoodleButton_Click" />
                    <Button x:Name="UfindButton" Content="Open in u:find" Click="UfindButton_Click" />
                </StackPanel>
                <TextBlock Text="Sessions" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <ToggleSwitch x:Name="PastSwitch" Header="Show past sessions" Toggled="PastSwitch_Toggled" />
                <StackPanel x:Name="SessionsPanel" Spacing="2" />
                <StackPanel x:Name="ExamsPanel" Spacing="4" />
                <StackPanel x:Name="InfoPanel" Spacing="6" />
                <Expander x:Name="HistoryExpander" Header="History" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Expanding="HistoryExpander_Expanding" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <ListView x:Name="HistoryList" MaxHeight="180" SelectionChanged="HistoryList_SelectionChanged" />
                        <StackPanel x:Name="DiffPanel" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="EmptyHint" Grid.Column="1" Text="No courses yet — click “Sync courses”." HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                   Text="Course data comes from u:space and u:find (Universität Wien). This app is not provided by the university; the university takes no responsibility for the correctness of the data shown here. Non-commercial personal use." />
    </Grid>
</Page>
