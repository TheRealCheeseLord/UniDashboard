<Page
    x:Class="MoodleDashboard.App.PlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,16,24,10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Exam planner" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Recommendation only — nothing is registered for you. Register for the dates you choose in u:space. The plan avoids clashes with your lectures and with each other and never suggests a date whose registration has closed." />

            <Grid ColumnSpacing="24" RowSpacing="8" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <RadioButtons x:Name="StrategyButtons" MaxColumns="1" SelectionChanged="Strategy_SelectionChanged" Grid.RowSpan="2">
                    <RadioButton Content="As soon as possible" Tag="Earliest" />
                    <RadioButton Content="As late as possible" Tag="Latest" />
                    <RadioButton Content="As spaced out as possible" Tag="Spread" />
                </RadioButtons>

                <!-- Spread slider (only for the "spaced out" strategy) -->
                <StackPanel x:Name="SpreadPanel" Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Ideal gap between exams (kept as close to it as possible):" VerticalAlignment="Center" />
                        <TextBlock x:Name="GapLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Slider x:Name="GapSlider" Minimum="1" Maximum="61" Value="61" StepFrequency="1" TickFrequency="10" TickPlacement="Outside"
                            MaxWidth="560" HorizontalAlignment="Left" Width="560" ValueChanged="GapSlider_ValueChanged" />
                    <TextBlock Text="1 day  ◂ close together  ·  far apart ▸  Maximum (as large as possible)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Optional date range (all strategies) -->
                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Only dates" VerticalAlignment="Center" />
                    <CalendarDatePicker x:Name="NotBeforePicker" PlaceholderText="not before (optional)" DateChanged="Range_DateChanged" />
                    <Button x:Name="ClearBefore" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="ClearBefore_Click" ToolTipService.ToolTip="Clear" />
                    <TextBlock Text="–" VerticalAlignment="Center" />
                    <CalendarDatePicker x:Name="NotAfterPicker" PlaceholderText="not after (optional)" DateChanged="Range_DateChanged" />
                    <Button x:Name="ClearAfter" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="ClearAfter_Click" ToolTipService.ToolTip="Clear" />
                    <Button x:Name="ResetButton" Content="Reset pins" Click="ResetButton_Click" Margin="24,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <SelectorBar x:Name="PageBar" Grid.Row="1" SelectionChanged="PageBar_SelectionChanged" HorizontalAlignment="Left">
            <SelectorBarItem Text="Plan" Tag="plan" IsSelected="True" />
            <SelectorBarItem Text="Calendar" Tag="calendar" />
        </SelectorBar>

        <ScrollViewer x:Name="PlanScroll" Grid.Row="2">
            <StackPanel x:Name="PlanPanel" Spacing="8" Padding="0,0,12,16" />
        </ScrollViewer>
        <ScrollViewer x:Name="CalendarScroll" Grid.Row="2" Visibility="Collapsed">
            <StackPanel x:Name="CalendarPanel" Spacing="10" Padding="0,0,12,16" />
        </ScrollViewer>
    </Grid>
</Page>
